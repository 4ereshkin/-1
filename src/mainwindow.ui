<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry"><rect><x>0</x><y>0</y><width>1000</width><height>720</height></rect></property>
  <property name="windowTitle"><string>Инерциальная навигация — вариант 1</string></property>
  <widget class="QWidget" name="centralwidget">
   <layout class="QHBoxLayout" name="horizontalLayout" stretch="1,0">
    <item><widget class="TrajectoryView" name="graphicsView"><property name="minimumSize"><size><width>500</width><height>400</height></size></property><property name="toolTip"><string>Синяя — ИНС; зелёная — истина; оранжевая — фильтр. Координаты в метрах, Y направлен вниз. Колесо — масштаб, левая кнопка — перемещение, F — автообзор.</string></property></widget></item>
    <item><widget class="QScrollArea" name="controlsScrollArea"><property name="minimumSize"><size><width>355</width><height>0</height></size></property><property name="widgetResizable"><bool>true</bool></property><property name="frameShape"><enum>QFrame::NoFrame</enum></property><widget class="QWidget" name="controlsWidget"><layout class="QVBoxLayout" name="controlsLayout">
     <item><widget class="QLabel" name="labelMotion"><property name="text"><string>Режим движения:</string></property><property name="buddy"><cstring>comboMotion</cstring></property></widget></item>
     <item><widget class="QComboBox" name="comboMotion"><property name="toolTip"><string>Для смены режима после запуска нажмите Сброс.</string></property><item><property name="text"><string>Постоянное ускорение</string></property></item><item><property name="text"><string>Движение по окружности</string></property></item></widget></item>
     <item><widget class="QLabel" name="labelRadius"><property name="text"><string>Радиус, м:</string></property><property name="buddy"><cstring>spinRadius</cstring></property></widget></item>
     <item><widget class="QDoubleSpinBox" name="spinRadius"><property name="minimum"><double>1.0</double></property><property name="maximum"><double>10000.0</double></property><property name="value"><double>100.0</double></property></widget></item>
     <item><widget class="QLabel" name="labelPeriod"><property name="text"><string>Период оборота, с:</string></property><property name="buddy"><cstring>spinPeriod</cstring></property></widget></item>
     <item><widget class="QDoubleSpinBox" name="spinPeriod"><property name="minimum"><double>1.0</double></property><property name="maximum"><double>3600.0</double></property><property name="value"><double>40.0</double></property></widget></item>
     <item><widget class="QLabel" name="labelAx"><property name="text"><string>Ускорение X, м/с²:</string></property><property name="buddy"><cstring>lineEditAx</cstring></property></widget></item>
     <item><widget class="QLineEdit" name="lineEditAx"><property name="text"><string>0.5</string></property><property name="accessibleName"><string>Ускорение X</string></property></widget></item>
     <item><widget class="QLabel" name="labelAy"><property name="text"><string>Ускорение Y, м/с²:</string></property><property name="buddy"><cstring>lineEditAy</cstring></property></widget></item>
     <item><widget class="QLineEdit" name="lineEditAy"><property name="text"><string>0.3</string></property><property name="accessibleName"><string>Ускорение Y</string></property></widget></item>
     <item><widget class="QLabel" name="labelLegend"><property name="sizePolicy"><sizepolicy hsizetype="Preferred" vsizetype="Fixed"><horstretch>0</horstretch><verstretch>0</verstretch></sizepolicy></property><property name="text"><string>Смещение акселерометра: 0.02 м/с²
по каждой оси. Шаг: 50 мс.</string></property></widget></item>
     <item><widget class="QCheckBox" name="checkAutoFollow"><property name="text"><string>Автообзор траекторий (F)</string></property><property name="checked"><bool>true</bool></property><property name="toolTip"><string>Показывать траектории целиком. Колесо и перетаскивание переключают камеру в ручной режим.</string></property></widget></item>
     <item><widget class="QGroupBox" name="filterGroup"><property name="title"><string>Комплементарный фильтр</string></property><layout class="QVBoxLayout" name="filterLayout">
      <item><widget class="QCheckBox" name="checkCorrection"><property name="text"><string>Автоматическая коррекция</string></property><property name="checked"><bool>true</bool></property><property name="toolTip"><string>Можно переключать во время движения. Выключение сохраняет координаты и скорость фильтра; включение возобновляет поправки по новым измерениям.</string></property></widget></item>
      <item><widget class="QCheckBox" name="checkExternalSensor"><property name="text"><string>Внешний датчик доступен (5 Гц)</string></property><property name="checked"><bool>true</bool></property><property name="toolTip"><string>Имитация камеры или маяка: новые координаты каждые 0.2 с. Без датчика фильтр движется по ИНС.</string></property></widget></item>
      <item><layout class="QFormLayout" name="filterParametersLayout">
       <item row="0" column="0"><widget class="QLabel" name="labelSensorNoise"><property name="text"><string>Шум датчика, м:</string></property><property name="buddy"><cstring>spinSensorNoise</cstring></property></widget></item>
       <item row="0" column="1"><widget class="QDoubleSpinBox" name="spinSensorNoise"><property name="maximum"><double>10.0</double></property><property name="singleStep"><double>0.1</double></property><property name="value"><double>0.5</double></property><property name="toolTip"><string>Стандартное отклонение случайной ошибки по каждой оси. 0 — идеальные измерения.</string></property></widget></item>
       <item row="1" column="0"><widget class="QLabel" name="labelResponseTime"><property name="text"><string>Время реакции, с:</string></property><property name="buddy"><cstring>spinResponseTime</cstring></property></widget></item>
       <item row="1" column="1"><widget class="QDoubleSpinBox" name="spinResponseTime"><property name="minimum"><double>0.2</double></property><property name="maximum"><double>20.0</double></property><property name="singleStep"><double>0.2</double></property><property name="value"><double>2.0</double></property><property name="toolTip"><string>Меньше — быстрее исправление ошибки, больше влияние шума. Больше — плавнее и медленнее коррекция.</string></property></widget></item>
      </layout></item>
      <item><widget class="QLabel" name="labelFilterLegend"><property name="text"><string>Зелёная — истина · Синяя — ИНС
Оранжевая — фильтр</string></property></widget></item>
     </layout></widget></item>
     <item><widget class="QPushButton" name="btnStart"><property name="text"><string>Старт</string></property></widget></item>
     <item><widget class="QCheckBox" name="checkSound"><property name="text"><string>Звук полёта</string></property><property name="toolTip"><string>Проигрывать MP3 по кругу во время движения. Пауза останавливает звук, продолжение возобновляет, сброс возвращает запись к началу. Громкость 30%.</string></property></widget></item>
     <item><widget class="QPushButton" name="btnCorrect"><property name="text"><string>Разовая коррекция ИНС</string></property><property name="toolTip"><string>Совместить синюю оценку с истиной и обнулить её скорость, как в задании. Оранжевая оценка фильтра не меняется.</string></property></widget></item>
     <item><widget class="QPushButton" name="btnReset"><property name="text"><string>Сброс</string></property></widget></item>
     <item><widget class="QLabel" name="labelStatus"><property name="alignment"><set>Qt::AlignLeft|Qt::AlignTop</set></property><property name="minimumSize"><size><width>270</width><height>150</height></size></property><property name="text"><string>Готово</string></property><property name="wordWrap"><bool>true</bool></property><property name="textInteractionFlags"><set>Qt::TextSelectableByMouse</set></property></widget></item>
     <item><spacer name="verticalSpacer"><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>40</height></size></property></spacer></item>
    </layout></widget></widget></item>
   </layout>
  </widget>
 </widget>
